// ============================================================================
// Benchmark 02: Allocation-Intensive Workload (AMA Region Arena vs Heap Structs)
// Phase A: 2,000,000 ephemeral allocations across 200 batches of 10,000 objects
//          in `region batch_arena` (O(1) bump-pointer + O(1) bulk region reset)
//          compared against 2,000,000 individual heap allocations in C/Rust.
// Phase B: 200,000 struct initializations (`ArenaNode`), showing the cost of
//          APS v1.0 heap-boxed struct allocation (`@aps_alloc`) vs stack structs.
// ============================================================================

module bench_allocation_region_arena

struct ArenaNode {
    id: i64
    weight: i64
    tag: i64
    checksum: i64
}

fn run_region_arena_batches(batches: i64, items_per_batch: i64) -> i64 {
    var total_acc: i64 = 0
    for b in 0..batches {
        var batch_sum: i64 = 0
        region batch_arena {
            for i in 0..items_per_batch {
                let raw = ((b * items_per_batch + i) * 1664525 + 1013904223) & 2147483647
                let allocated_val = batch_arena.alloc(raw)
                batch_sum += allocated_val & 65535
            }
        }
        total_acc += batch_sum
    }
    return total_acc
}

fn run_struct_allocations(count: i64) -> i64 {
    var struct_acc: i64 = 0
    for i in 0..count {
        let node = ArenaNode {
            id: i,
            weight: (i * 7 + 3) & 65535,
            tag: (i ^ 12345) & 65535,
            checksum: (i * 13) & 65535
        }
        struct_acc += node.weight + node.tag + node.checksum
    }
    return struct_acc
}

fn main() {
    let t0 = time_now_ns()
    let arena_sum = run_region_arena_batches(200, 10000)
    let t1 = time_now_ns()
    let struct_sum = run_struct_allocations(200000)
    let t2 = time_now_ns()

    let arena_us = (t1 - t0) / 1000
    let struct_us = (t2 - t1) / 1000
    let total_us = (t2 - t0) / 1000
    let checksum = arena_sum + struct_sum

    print("BENCH_02_ALLOC elapsed_us=")
    print(total_us)
    print(" arena_2M_us=")
    print(arena_us)
    print(" struct_200k_us=")
    print(struct_us)
    print(" checksum=")
    println(checksum)
}
