// ============================================================================
// Файл: 01_hello_world.aps
// Описание: Базовая программа на языке программирования APS (Advanced Performance Systems).
// Демонстрирует точку входа `fn main()`, вывод на экран (`print`, `println`),
// строковые литералы и форматированный вывод.
// ============================================================================

module main

import std.io

// Главная точка входа в программу APS.
// Компилятор ожидает функцию `main` без обязательных аргументов.
fn main() {
    // Вывод строки с переводом каретки в конце
    println("Hello, World! Добро пожаловать в APS (Advanced Performance Systems)!")

    // Вывод нескольких фрагментов на одной строке без автоматического перевода строки
    print("Статус системы: ")
    println("АКТИВЕН")

    // Объявление неизменяемых переменных и вывод их значений
    let language = "APS"
    let version_major: i64 = 1
    let version_minor: i64 = 0
    let memory_model = "AMA (Adaptive Memory Architecture)"

    println("--------------------------------------------------")
    print("Язык: ")
    println(language)

    print("Версия спецификации: ")
    print(version_major)
    print(".")
    println(version_minor)

    print("Архитектура памяти: ")
    println(memory_model)
    println("--------------------------------------------------")
}
