// ============================================================================
// APS Native Windows GUI Application (Tkinter Equivalent)
// Ultra-fast Win32 Controls (< 1ms startup, ~2MB RAM)
// Run with: .\aps.exe run examples/gui_counter_and_calculator.aps
// ============================================================================

module gui_counter_demo

fn on_greet_clicked() {
    gui_alert("Hello from APS!", "APS Native Windows GUI is running smoothly with 0 ms overhead!")
}

fn on_confirm_clicked() {
    let ok = gui_confirm("APS GUI Dialog", "Do you like the native Windows GUI in APS?")
    if ok {
        gui_alert("Awesome!", "Thank you! Native Windows controls are fast and lightweight.")
    } else {
        gui_alert("Feedback", "We appreciate your feedback!")
    }
}

fn main() {
    println("=== Starting APS Native Windows GUI Demo ===")

    // 1. Создаем главное окно 440x320
    let win = gui_window_create("APS Native GUI Application (Tkinter for APS)", 440, 320)

    // 2. Текстовый заголовок
    gui_add_label(win, "=== APS Native Win32 Desktop App ===", 30, 20, 380, 25)

    // 3. Поле ввода имени
    gui_add_label(win, "Your Name:", 30, 60, 100, 20)
    let inp = gui_add_input(win, "APS Developer", 120, 56, 270, 26)

    // 4. Кнопки действий
    gui_add_button(win, "Say Hello (MessageBox)", 30, 100, 360, 34, on_greet_clicked)
    gui_add_button(win, "Question Dialog (Confirm)", 30, 145, 360, 34, on_confirm_clicked)

    // 5. Информационная метка состояния
    let lbl_status = gui_add_label(win, "Status: Ready (Zero-cost native controls)", 30, 200, 380, 25)
    gui_widget_set_text(win, lbl_status, "Status: All Win32 Controls Initialized!")

    println("GUI Window is initialized! Close the window or press exit.")
    gui_window_run(win)
    gui_window_close(win)
    println("APS GUI Application exited cleanly.")
}
