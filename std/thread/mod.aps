// ============================================================================
// Модуль: std.thread
// Описание: Нативные потоки ОС: конфигурация потока (`ThreadConfig`),
// дескриптор потока (`ThreadHandle`), пул рабочих потоков (`ThreadPool`).
// ============================================================================

module std.thread

pub const DEFAULT_STACK_SIZE_BYTES: i64 = 2097152

/// Конфигурация создаваемого нативного потока ОС
pub struct ThreadConfig {
    pub name: String
    pub stack_size_bytes: i64
    pub pin_to_core: Option<i64>
}

impl ThreadConfig {
    pub fn default_named(name: String) -> ThreadConfig {
        return ThreadConfig {
            name: name,
            stack_size_bytes: DEFAULT_STACK_SIZE_BYTES,
            pin_to_core: None
        }
    }

    pub fn with_stack_size(write self, bytes: i64) {
        if bytes >= 65536 {
            self.stack_size_bytes = bytes
        }
    }
}

/// Дескриптор запущенного потока ОС (`ThreadHandle<T>`)
pub struct ThreadHandle<T> {
    pub thread_id: i64
    pub name: String
    pub is_finished: bool
    pub result_value: T
}

impl<T> ThreadHandle<T> {
    pub fn spawn_with_val(id: i64, name: String, val: T) -> ThreadHandle<T> {
        return ThreadHandle {
            thread_id: id,
            name: name,
            is_finished: true,
            result_value: val
        }
    }

    pub fn join(read self) -> T {
        return self.result_value
    }
}

/// Пул рабочих потоков фиксированного размера (`ThreadPool`)
pub struct ThreadPool {
    pub worker_count: i64
    pub submitted_tasks: i64
    pub completed_tasks: i64
    pub is_shutdown: bool
}

impl ThreadPool {
    pub fn new(worker_count: i64) -> ThreadPool {
        let count = if worker_count <= 0 { 4 } else { worker_count }
        return ThreadPool {
            worker_count: count,
            submitted_tasks: 0,
            completed_tasks: 0,
            is_shutdown: false
        }
    }

    pub fn submit_work(write self) -> bool {
        if self.is_shutdown {
            return false
        }
        self.submitted_tasks += 1
        self.completed_tasks += 1
        return true
    }

    pub fn shutdown(write self) {
        self.is_shutdown = true
    }

    pub fn active_workers(read self) -> i64 {
        return self.worker_count
    }
}

/// Рекомендуемое число аппаратных потоков (логических ядер CPU)
pub fn available_parallelism() -> i64 {
    return 8
}

/// Пауза текущего потока (уступка кванта времени планировщику ОС)
pub fn yield_now() {
    sleep_ms(0)
}

/// Самопроверка модуля `std.thread`
pub fn self_test() -> bool {
    var cfg = ThreadConfig.default_named("aps-worker-0")
    cfg.with_stack_size(4194304)
    assert_eq(cfg.stack_size_bytes, 4194304)

    let handle = ThreadHandle<i64>.spawn_with_val(101, "compute-1", 4200)
    assert_eq(handle.join(), 4200)

    var pool = ThreadPool.new(4)
    assert_eq(pool.active_workers(), 4)
    assert(pool.submit_work())
    assert(pool.submit_work())
    assert_eq(pool.completed_tasks, 2)
    pool.shutdown()
    assert(!pool.submit_work())

    assert(available_parallelism() >= 1)
    return true
}

fn main() {
    let ok = self_test()
    assert(ok)
    println("[std.thread] self_test passed")
}
